# Copy to .env and fill in real values.
# Read by docker-compose.yml and by the Spring Boot app (postgres profile).
# Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment

# JWT signing key - must be at least 32 bytes for HS384
JWT_SECRET=change-me-in-production-at-least-32-bytes-long!

# Optional overrides
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://localhost:5433/recruitment
# DB_USERNAME=recruitment
# DB_PASSWORD=recruitment
# UPLOAD_DIR=uploads
